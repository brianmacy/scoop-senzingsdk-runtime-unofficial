{
  "version": "4.3.0.26135",
  "description": "DEPRECATED - Use official bucket: github.com/Senzing/scoop-senzingsdk",
  "homepage": "https://senzing.com/senzing-api/",
  "license": {
    "identifier": "Proprietary",
    "url": "https://senzing.com/software-license-agreement/"
  },
  "notes": [
    "*** DEPRECATED: This unofficial package is no longer maintained. ***",
    "*** Please migrate to the official Senzing Scoop bucket:        ***",
    "***   scoop uninstall senzingsdk-runtime-unofficial              ***",
    "***   scoop bucket rm senzingsdk-runtime-unofficial              ***",
    "***   scoop bucket add senzingsdk https://github.com/Senzing/scoop-senzingsdk ***",
    "***   scoop install senzingsdk-runtime                           ***",
    "",
    "Senzing SDK Runtime has been installed.",
    "",
    "Environment variables have been configured:",
    "  SENZING_DIR: $dir\\er",
    "  PATH: $dir\\er\\lib (added)",
    "",
    "To verify installation:",
    "  echo $env:SENZING_DIR",
    "",
    "IMPORTANT: By installing this package, you accept the Senzing EULA:",
    "  https://senzing.com/software-license-agreement/"
  ],
  "extract_dir": "senzing",
  "architecture": {
    "64bit": {
      "url": "https://senzing-production-win.s3.amazonaws.com/SenzingSDK_4.3.0.26135.zip",
      "hash": "fa5f68dfafada2a952c478f4cefa95ed5c95b0af1608da6ca393475eb568c206"
    }
  },
  "pre_install": [
    "Write-Host ''",
    "Write-Host '╔══════════════════════════════════════════════════════════════════╗' -ForegroundColor Red",
    "Write-Host '║  DEPRECATED: This unofficial package is no longer maintained.   ║' -ForegroundColor Red",
    "Write-Host '║  Please migrate to the official Senzing Scoop bucket:           ║' -ForegroundColor Red",
    "Write-Host '║                                                                 ║' -ForegroundColor Red",
    "Write-Host '║    scoop uninstall senzingsdk-runtime-unofficial                ║' -ForegroundColor Red",
    "Write-Host '║    scoop bucket rm senzingsdk-runtime-unofficial                ║' -ForegroundColor Red",
    "Write-Host '║    scoop bucket add senzingsdk                                  ║' -ForegroundColor Red",
    "Write-Host '║      https://github.com/Senzing/scoop-senzingsdk               ║' -ForegroundColor Red",
    "Write-Host '║    scoop install senzingsdk-runtime                             ║' -ForegroundColor Red",
    "Write-Host '╚══════════════════════════════════════════════════════════════════╝' -ForegroundColor Red",
    "Write-Host ''",
    "",
    "$eulaUrl = 'https://senzing.com/software-license-agreement/'",
    "",
    "# Check if EULA has been accepted",
    "$envAccepted = $env:SENZING_EULA_ACCEPTED",
    "$configAccepted = scoop config SENZING_EULA_ACCEPTED",
    "",
    "if ($envAccepted -ne 'yes' -and $configAccepted -ne 'yes') {",
    "    Write-Host ''",
    "    Write-Host 'Senzing SDK Runtime requires acceptance of the End User License Agreement (EULA).' -ForegroundColor Yellow",
    "    Write-Host \"EULA: $eulaUrl\" -ForegroundColor Cyan",
    "    Write-Host ''",
    "    Write-Host 'To accept the EULA, you can:' -ForegroundColor Yellow",
    "    Write-Host '  1. Set environment variable: $env:SENZING_EULA_ACCEPTED = \"yes\"' -ForegroundColor Gray",
    "    Write-Host '  2. Set scoop config: scoop config SENZING_EULA_ACCEPTED yes' -ForegroundColor Gray",
    "    Write-Host ''",
    "    $response = Read-Host 'Do you accept the Senzing EULA? (yes/no)'",
    "    if ($response -ne 'yes') {",
    "        throw 'Installation cancelled: EULA not accepted'",
    "    }",
    "}"
  ],
  "env_add_path": "er\\lib",
  "env_set": {
    "SENZING_DIR": "$dir\\er"
  },
  "checkver": {
    "url": "https://senzing-production-win.s3.amazonaws.com/",
    "regex": "SenzingSDK_([\\d.]+)\\.zip"
  },
  "autoupdate": {
    "extract_dir": "senzing",
    "architecture": {
      "64bit": {
        "url": "https://senzing-production-win.s3.amazonaws.com/SenzingSDK_$version.zip"
      }
    }
  }
}
